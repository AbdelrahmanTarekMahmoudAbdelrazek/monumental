{
  "name": "@monumental/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sim:tournament": "node scripts/tournament-sim.mjs"
  },
  "dependencies": {
    "@monumental/db": "workspace:*",
    "@monumental/shared": "workspace:*",
    "@socket.io/redis-adapter": "^8.3.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "ioredis": "^5.6.1",
    "jose": "^6.0.11",
    "nanoid": "^5.1.5",
    "socket.io": "^4.8.1",
    "zod": "^4.0.0",
    "@prisma/client": "^7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.0",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0",
    "tsup": "^8.5.0"
  }
}
