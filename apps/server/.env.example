# ── Socket server ──
PORT=4000
# Comma-separated allowed browser origins
CORS_ORIGINS=http://localhost:3000
# Shared secret used by the web app to sign short-lived socket tokens (must match apps/web)
SOCKET_JWT_SECRET=change-me-to-a-long-random-string
# Optional — live room snapshots + multi-instance socket adapter. Leave empty for in-memory.
REDIS_URL=redis://localhost:6379
# Optional — persists results, stats, leaderboards and runs tournaments. Leave empty for ephemeral play.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/monumental
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/monumental
# Tournament scheduler
TOURNAMENTS_ENABLED=true
HOURLY_TOURNAMENT_LEVEL=3
