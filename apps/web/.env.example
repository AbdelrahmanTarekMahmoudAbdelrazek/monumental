# ── Web app (Next.js) ──
# Public URL of the Socket.io server (Railway / Fly)
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
# Must match SOCKET_JWT_SECRET on the socket server
SOCKET_JWT_SECRET=change-me-to-a-long-random-string

# Postgres (Supabase: use the pooled URL for DATABASE_URL and the direct URL for migrations)
# Homebrew Postgres on macOS has no "postgres" user: use postgresql://<your-mac-username>@localhost:5432/monumental
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/monumental
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/monumental

# Auth.js
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
# Google OAuth (optional)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Email magic links via SMTP (optional) – e.g. Resend: smtp.resend.com:465, user "resend", pass = API key
EMAIL_SERVER=smtp://user:pass@smtp.example.com:587
EMAIL_FROM=MONUMENTAL <no-reply@example.com>

# Comma-separated emails that get the ADMIN role on first sign-in
ADMIN_EMAILS=you@example.com
